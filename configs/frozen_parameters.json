{
  "schema_version": 1,
  "method": {
    "window_epochs": 30,
    "motion_margin": 2.0,
    "separation_margin": 2.0,
    "subset_policy": "full",
    "pair_factor_mode": "consensus",
    "loewner_floor_m": 1.0,
    "loss_family": "cauchy",
    "cauchy_scale": 2.5
  },
  "initialization": {
    "alignment_prefix_epochs": 120,
    "initial_prefix_epochs": 60,
    "minimum_horizontal_displacement_m": 30.0,
    "minimum_heading_change_deg": 15.0,
    "minimum_duration_s": 60.0,
    "scale_estimation": false
  },
  "graph_noise": {
    "prior_rotation_sigma_deg": 5.0,
    "prior_translation_sigma_m": [0.5, 0.5, 0.8],
    "kiss_rotation_sigma_deg": 0.5,
    "kiss_translation_sigma_m": 0.1
  },
  "statistics": {
    "bootstrap_replicates": 10000,
    "block_epochs": 30,
    "familywise_alpha": 0.05,
    "multiple_comparison_correction": "Holm"
  }
}
